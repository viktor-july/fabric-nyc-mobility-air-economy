table FactTaxiDaily
	lineageTag: 11937d4a-d08f-421a-85c4-9a5f0987c33a
	sourceLineageTag: [dbo].[FactTaxiDaily]

	measure 'Revenue USD' = SUM(FactTaxiDaily[total_usd_sum])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 23922df6-3d07-433e-b7d1-8e3d70ea1123

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg Revenue per Trip USD' = DIVIDE([Revenue USD], [Total Trips])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 45c71f47-07b2-4c10-a248-34ce0afedbcf

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Avg PM2.5 NYC' =
			
			CALCULATE(
			    AVERAGE(FactAirQualityDaily[pm25_avg]),
			    DimStation[in_nyc] = TRUE()
			)
		formatString: 0.00
		lineageTag: b1cd701b-f75b-4d1e-b238-258e55d1cbca

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg NO2 NYC' =
			
			CALCULATE(
			    AVERAGE(FactAirQualityDaily[no2_avg]),
			    DimStation[in_nyc] = TRUE()
			)
		lineageTag: b9e505b4-d8a7-441c-b340-aee059253b7d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Trips' = SUM(FactTaxiDaily[trips])
		formatString: #,0
		lineageTag: 0d60a43b-80f2-4ffb-bfe4-d3151d9e943f

		changedProperty = Name

		changedProperty = FormatString

	measure 'Revenue EUR' =
			
			SUMX(
			    VALUES(DimDate[date_key]),
			    [Revenue USD] * CALCULATE(MAX(DimFX[eur_per_usd]))
			)
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 7b4e050b-5205-4f5d-afeb-79d5ab7f8824

		changedProperty = Name

		changedProperty = FormatString

	measure 'Avg Revenue per Trip EUR' = DIVIDE([Revenue EUR], [Total Trips])
		formatString: "€"\ #,0.00;-"€"\ #,0.00;"€"\ #,0.00
		lineageTag: 57688acd-ef9d-4e4c-81a0-e043bb9b0a5c

		changedProperty = Name

		changedProperty = FormatString

	measure 'GDP USD tn' =
			
			VAR y = MAX(DimDate[year])
			RETURN
			CALCULATE(
			    SUM(DimGDP[gdp_usd]) / 1e12,
			    TREATAS({y}, DimGDP[year])
			)
		formatString: 0.00
		lineageTag: 81e15ded-bab1-469b-8c80-8800a3f02cca

		changedProperty = Name

		changedProperty = FormatString

